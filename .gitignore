# Never commit secrets — the browser/frontend never holds a credential (HANDOFF §4.5)
*.key
*.pem
*.token
.env
.env.*
secrets*.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python (only if an optional build script / backend is added later)
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Phase 67 — the vendored aml-casework venv is BUILT by `make setup`, never committed (the source IS).
vendor/aml-casework/.venv/
.ruff_cache/

# Node (not used; guard only)
node_modules/

# FinCEN corpus: raw acquired PDFs (data/fincen/raw/) are large + regenerable
# (scripts/acquire_fincen.py), so they stay LOCAL — not committed.
# The full-corpus MARKDOWN (data/fincen/*.md) IS committed as of Phase 12: it is the
# derivation surface for the corpus-backed demo, public-domain FinCEN (17 USC §105), and
# the offline-reproducible input to the deterministic spine. The build/derive read the .md,
# not the PDF. (Reverses Phase-10's no-bulk-md call — the corpus now backs the demo.)
data/fincen/raw/
# Phase 20: FinCEN ALERTS as a second source — same convention (raw PDFs local + regenerable;
# the committed data/fincen-alerts/*.md is the derivation surface).
data/fincen-alerts/raw/
# Phase 21: OFAC as a third source (US-federal public domain, 17 USC §105) — same convention
# (raw PDFs local + regenerable from the hand-curated data/ofac/index.json; the committed *.md ships).
data/ofac/raw/
# Phase 22: FINTRAC as a fourth source (FIRST cross-jurisdiction — Canadian Crown copyright, reproduced
# verbatim for NON-COMMERCIAL use with attribution per FINTRAC's Terms & Conditions, NOT public domain) —
# same convention (raw PDFs local + regenerable from the hand-curated data/fintrac/index.json; *.md ships).
data/fintrac/raw/
# Phase 33: FINTRAC per-sector ML/TF indicator GUIDANCE (HTML, not PDF) — same convention (raw HTML local +
# regenerable from the hand-curated data/fintrac-guidance/index.json via acquire_fincen.py --html; *.md ships).
data/fintrac-guidance/raw/
# Phase 36: the live companion's runtime persistence — the DuckDB scan store + its parquet exports are
# regenerable LOCAL runtime data (scan history from pasted/picked articles), NEVER committed; DuckDB is
# venv-only and never on the ship path. The offline dist/news carries zero store code.
data/news/.live/
*.duckdb
*.parquet

# Authoring scratch: scaffolded config SKELETONS from scripts/derive_signals.py --scaffold
# (Phase 11). A draft is reviewed, has its JUDGMENT fields filled, then RENAMED to
# config/typologies/<id>.json (a committed config). The .draft.json itself is transient,
# regenerable, and build-INVALID by design — never committed, never shipped.
config/typologies/*.draft.json

# Knowledge wiki: machine-local symlink to the central registered aml-wiki
# (/Users/jwang/private-knowledge/aml-wiki). The association is documented in
# CLAUDE.md; the symlink itself is per-machine and not repo content.
/wiki

# Audit trail (forensic, not source)
.nana/audit.jsonl

# Dev-wiki transient breadcrumbs + hook logs (not source)
.dev-wiki/.stale-queue
.dev-wiki/.session-end
.dev-wiki/.pending-commit
.dev-wiki/enforcement.log

# dev-wiki scratch / intermediate workflow artifacts
.dev-wiki/tmp/
.claude/.memory-consulted

# nana memory MCP per-project store (binary DB; never commit)
.memory/*.db*

# Phase 74 — the entity spine's runtime DuckDB store (companion-only; never committed)
data/entity-spine/store/
