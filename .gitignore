# Never commit secrets — the browser/frontend never holds a credential (HANDOFF §4.5)
*.key
*.pem
*.token
.env
.env.*
secrets*.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python (only if an optional build script / backend is added later)
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node (not used; guard only)
node_modules/

# FinCEN corpus: raw acquired PDFs (data/fincen/raw/) AND the full-corpus markdown
# mirror are regenerable (scripts/crawl_fincen.py + acquire_fincen.py + pdf_to_md.py),
# so they stay LOCAL — not committed. Keeps the repo lean as the corpus scales.
# EXCEPTION: a .md that backs a shipped typology is committed source of truth and is
# explicitly allow-listed below (one !-line per derived advisory — this list IS the
# record of "commit only md actually derived from"). The build reads the .md, not the PDF.
data/fincen/raw/
data/fincen/*.md
!data/fincen/fin-2022-a002.md   # backs the elder-financial-exploitation typology (Phase 7)

# Authoring scratch: scaffolded config SKELETONS from scripts/derive_signals.py --scaffold
# (Phase 11). A draft is reviewed, has its JUDGMENT fields filled, then RENAMED to
# config/typologies/<id>.json (a committed config). The .draft.json itself is transient,
# regenerable, and build-INVALID by design — never committed, never shipped.
config/typologies/*.draft.json

# Knowledge wiki: machine-local symlink to the central registered aml-wiki
# (/Users/jwang/private-knowledge/aml-wiki). The association is documented in
# CLAUDE.md; the symlink itself is per-machine and not repo content.
/wiki

# Audit trail (forensic, not source)
.nana/audit.jsonl

# Dev-wiki transient breadcrumbs + hook logs (not source)
.dev-wiki/.stale-queue
.dev-wiki/.session-end
.dev-wiki/.pending-commit
.dev-wiki/enforcement.log
